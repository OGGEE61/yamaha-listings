{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamaha-listings",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yamaha-listings-db",
      "database_id": "ef53e020-1e9a-487d-a01e-0f0d59bd110d"
    }
  ],
  "vars": {
    "ADMIN_SYNC_SECRET": "yamaha-listing-tracker-secret-2026"
  }
}
