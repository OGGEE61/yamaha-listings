{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamaha-listings",
  "main": "src/worker/index.js",
  "preview_urls": false,
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yamaha-listings-db",
      "database_id": "ef53e020-1e9a-487d-a01e-0f0d59bd110d"
    },
    {
      "binding": "GUARD",
      "database_name": "site-login-guard",
      "database_id": "cbd6112d-8979-430c-be60-fbdca8329963"
    }
  ]
}
