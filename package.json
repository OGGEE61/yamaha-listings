{
  "name": "yamaha-listings",
  "version": "1.0.0",
  "description": "Yamaha motorcycle listings tracker and dashboard",
  "scripts": {
    "start": "node src/server/server.js",
    "dev": "node src/server/server.js",
    "scrape": "node src/scraper/scraper.js",
    "color-check": "node src/ai/vision.js",
    "deploy": "npx wrangler deploy",
    "worker:dev": "npx wrangler dev",
    "d1:query": "npx wrangler d1 execute yamaha-listings-db --remote"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^4.22.3",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "puppeteer": "^25.12.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "random-useragent": "^0.5.0",
    "sharp": "^0.35.5"
  },
  "main": "src/server/server.js"
}
